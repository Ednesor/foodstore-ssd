# =============================================================================
# Food Store — Frontend Environment Variables
# Copiar este archivo a .env y completar con los valores correspondientes
# NUNCA commitear el archivo .env real al repositorio
# =============================================================================

# URL base del backend (sin trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# URL base para desarrollo (Vite)
VITE_BASE_URL=/

# =============================================================================
# MercadoPago — Public Key (frontend only)
# Esta clave es pública y se usa en el lado del cliente
# Obtener de: https://www.mercadopago.com.ar/developers/panel
# =============================================================================

# Public Key para SDK de MercadoPago (usar TEST- para desarrollo)
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================================
# Configuración de aplicación
# =============================================================================

# Entorno (development / production)
VITE_APP_ENV=development

# Debug mode (True/False)
VITE_DEBUG=True
