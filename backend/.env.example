# =============================================================================
# Food Store — Backend Environment Variables
# Copiar este archivo a .env y completar con los valores correspondientes
# NUNCA commitear el archivo .env real al repositorio
# =============================================================================

# Base de datos PostgreSQL
DATABASE_URL=postgresql://foodstore:foodstore@localhost:5432/foodstore_db

# Clave secreta para firmar JWT (mínimo 32 caracteres, usar openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# Algoritmo JWT
ALGORITHM=HS256

# Duración del access token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Duración del refresh token en días
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes CORS permitidos (JSON array, desarrollo: localhost:5173)
CORS_ORIGINS=["http://localhost:5173"]

# =============================================================================
# MercadoPago — Credenciales
# Obtener de: https://www.mercadopago.com.ar/developers/panel
# =============================================================================

# Access Token (backend) — usar TEST- para desarrollo
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Public Key (frontend) — usar TEST- para desarrollo
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL de callback para webhooks IPN de MercadoPago
# En desarrollo usar ngrok o similar: https://xxxx.ngrok.io/api/v1/pagos/webhook
MP_NOTIFICATION_URL=http://localhost:8000/api/v1/pagos/webhook

# =============================================================================
# Configuración de aplicación
# =============================================================================

# Entorno (development / production)
APP_ENV=development

# Debug mode (True/False)
DEBUG=True

# Zona horaria
TZ=America/Argentina/Buenos_Aires
